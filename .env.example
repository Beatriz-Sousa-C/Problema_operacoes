# Copie para .env.local (ignorado pelo git) e preencha. No Vercel, cadastre em Settings > Environment Variables.

# Obrigatória: senha que abre dados/*.csv.enc (os CSVs do desafio cifrados). Gere uma com:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DADOS_SENHA=

# Chave da Groq (console.groq.com > API Keys). Nunca commite a chave real.
# Sem ela, o app funciona com a tratativa padrão da política e avisa na tela.
GROQ_API_KEY=

# Opcional: modelos em ordem de preferência (se a cota de um acabar, tenta o próximo)
# GROQ_MODELOS=openai/gpt-oss-120b,llama-3.3-70b-versatile,openai/gpt-oss-20b

# Opcional: link do repositório exibido na aba Método
# NEXT_PUBLIC_REPO_URL=https://github.com/usuario/repositorio

# Opcional: limites da IA ao vivo. Padrões: 8 investigações por IP a cada 10 min (decisões de grupo: 5x isso),
# 400 chamadas e 400 mil tokens por dia somando todos os visitantes. Ao estourar, a tela mostra a política e avisa.
# LIMITE_IA_POR_IP=8
# LIMITE_IA_DIARIO=400
# LIMITE_IA_TOKENS_DIARIO=400000

# Opcional: 1 para regenerar o plano do agente no build mesmo que já exista
# FORCAR_PLANO=
